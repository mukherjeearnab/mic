@startuml
' Complete object diagram: ResidualMLP (PyTorch) as an instance of the ML MIC metamodel
' (ml.puml) extended with the ValueDescription sub-diagram (valueDescription.puml).
' Sources: models.py, training.py, normalization.py, inference.py, default.yaml
' Enum literals follow ml.puml where listed; otherwise they are assumptions. "TODO" = not in the sources.
left to right direction
hide empty members

' ===================== helper procedures (ValueDescription parts) =====================
!procedure $real($id, $prec)
object "<size:10>$id : RealType" as $id##_t {
  typeName = "Real"
  precision = "$prec"
}
$id *-- $id##_t : dataType
!endprocedure

!procedure $int($id, $bits, $signed)
object "<size:10>$id : IntegerType" as $id##_t {
  typeName = "Integer"
  bits = $bits
  signed = $signed
}
$id *-- $id##_t : dataType
!endprocedure

!procedure $unit($id, $sym, $ucum, $qudt)
object "<size:10>$id : Unit" as $id##_u {
  symbol = "$sym"
  ucumCode = "$ucum"
  qudtIRI = "$qudt"
}
$id *-- $id##_u : unit
!endprocedure

' float32 tensor, rank 2
!procedure $tensor2($id, $n1, $s1, $dyn1, $sem1, $n2, $s2, $dyn2, $sem2)
object "<size:10>$id : TensorType" as $id##_t {
  typeName = "Tensor"
  rank = 2
  layout = "dense"
  memoryOrder = "rowMajor"
}
object "<size:10>$id : RealType (elementType)" as $id##_e {
  typeName = "Real"
  precision = "single (float32)"
}
object "<size:10>$id : Dimension" as $id##_d1 {
  name = "$n1"
  size = $s1
  isDynamic = $dyn1
  semantic = "$sem1"
}
object "<size:10>$id : Dimension" as $id##_d2 {
  name = "$n2"
  size = $s2
  isDynamic = $dyn2
  semantic = "$sem2"
}
$id *-- $id##_t : dataType
$id##_t *-- $id##_e : elementType
$id##_t *-- $id##_d1 : shape
$id##_t *-- $id##_d2 : shape
!endprocedure

' float32 tensor, rank 1
!procedure $tensor1($id, $n1, $s1, $dyn1, $sem1)
object "<size:10>$id : TensorType" as $id##_t {
  typeName = "Tensor"
  rank = 1
  layout = "dense"
  memoryOrder = "rowMajor"
}
object "<size:10>$id : RealType (elementType)" as $id##_e {
  typeName = "Real"
  precision = "single (float32)"
}
object "<size:10>$id : Dimension" as $id##_d1 {
  name = "$n1"
  size = $s1
  isDynamic = $dyn1
  semantic = "$sem1"
}
$id *-- $id##_t : dataType
$id##_t *-- $id##_e : elementType
$id##_t *-- $id##_d1 : shape
!endprocedure

!procedure $ref($id, $uri, $fmt)
object "<size:10>$id : ReferenceValue" as $id##_v {
  uri = "$uri"
  format = "$fmt"
  checksum = "TODO"
}
$id *-- $id##_v : defaultValue
!endprocedure

!procedure $scalar($id, $lit, $role)
object "<size:10>$id : ScalarValue" as $id##_v {
  literal = "$lit"
}
$id *-- $id##_v : $role
!endprocedure

' RangeDomain with optional min / max
!procedure $range($id, $desc, $min, $minIncl, $max, $maxIncl)
object "<size:10>$id : RangeDomain" as $id##_rd {
  description = "$desc"
  kind = "range"
  minInclusive = $minIncl
  maxInclusive = $maxIncl
}
$id *-- $id##_rd : validityDomains
!if ($min != "")
object "<size:10>$id : ScalarValue (min)" as $id##_rmin {
  literal = "$min"
}
$id##_rd *-- $id##_rmin : min
!endif
!if ($max != "")
object "<size:10>$id : ScalarValue (max)" as $id##_rmax {
  literal = "$max"
}
$id##_rd *-- $id##_rmax : max
!endif
!endprocedure

' ===================== Root & general =====================
object "mic : MIC" as mic
object "generalInformation : GeneralInformation" as gi {
  name = "ResidualMLP"
  description = "MLP predicting the residual of the ThermalPlant FMU: T_hybrid = T_sim + ResidualMLP(T_sim, power, ambient)"
  owner = "TODO"
  lifeCycleState = "TODO"
  version = "TODO"
  versionDate = "TODO"
  confidentiality = []
  license = []
}
object "integration : Integration" as integ {
  fileFormat = "PyTorch checkpoint (.pt) + JSON normalization"
  runtime = "PyTorch (CPU)"
}
object "software : Software" as sw
mic *-- gi : generalInformation
mic *-- integ : integration
integ *-- sw : software

' ===================== Content and computation =====================
object "contentAndComputation : ContentAndComputation" as cc {
  mlTask = "regression (residual correction of a physical simulation)"
  modelCategory = "feed-forward neural network (MLP)"
}
object "architecture : Architecture" as arch {
  family = "MLP"
}
object "training : TrainingProcedure" as tp {
  algorithm = "Adam + MSELoss, mini-batch"
  randomSeed = "42"
}
object "ds_train : DatasetUse" as ds1 {
  name = "residual_dataset (train split)"
  role = train
  reference = "data/processed/residual_dataset.csv (80 %)"
}
object "ds_val : DatasetUse" as ds2 {
  name = "residual_dataset (validation split)"
  role = validation
  reference = "data/processed/residual_dataset.csv (20 %)"
}
mic *-- cc : contentAndComputation
cc *-- arch : architecture
cc *-- tp : training
tp *-- ds1 : datasets
tp *-- ds2 : datasets

object "L1 : Layer" as L1 {
  name = "net.0 Linear(3, 32)"
  type = "Linear"
  order = 1
}
object "A1 : Layer" as A1 {
  name = "net.1 Tanh"
  type = "Tanh"
  order = 2
}
object "L2 : Layer" as L2 {
  name = "net.2 Linear(32, 32)"
  type = "Linear"
  order = 3
}
object "A2 : Layer" as A2 {
  name = "net.3 Tanh"
  type = "Tanh"
  order = 4
}
object "L3 : Layer" as L3 {
  name = "net.4 Linear(32, 1)"
  type = "Linear"
  order = 5
}
arch *-- L1 : layers
arch *-- A1 : layers
arch *-- L2 : layers
arch *-- A2 : layers
arch *-- L3 : layers

' ===================== Ports, internal variables, parameters containers =====================
object "pivp : PortsInternalVariablesAndParameters" as pivp
object "ports : Ports" as ports
object "internalVariables : InternalVariables" as iv
object "parameters : Parameters" as params
mic *-- pivp : portsInternalVariablesAndParameters
pivp *-- ports : ports
pivp *-- iv : internalVariables
pivp *-- params : parameters

' ===================== Variables (ValueDescription <|-- Variable) =====================
object "temperature_sim : Variable" as vTs {
  name = "temperature_sim"
  description = "Temperature from the Modelica/FMU simulation"
  semanticIRI = []
  quantityKind = "ThermodynamicTemperature"
  inOut = In
  role = inputFeature
}
object "power : Variable" as vP {
  name = "power"
  description = "Applied power"
  semanticIRI = []
  quantityKind = "Power"
  inOut = In
  role = inputFeature
}
object "ambient : Variable" as vA {
  name = "ambient"
  description = "Ambient temperature"
  semanticIRI = []
  quantityKind = "ThermodynamicTemperature"
  inOut = In
  role = inputFeature
}
object "predicted_residual : Variable" as vR {
  name = "predicted_residual"
  description = "Predicted residual (T_measured - T_sim)"
  semanticIRI = []
  quantityKind = "TemperatureDifference"
  inOut = Out
  role = target
}
ports *-- vTs : variables
ports *-- vP : variables
ports *-- vA : variables
ports *-- vR : variables

$real(vTs, "single (float32)")
$real(vP, "single (float32)")
$real(vA, "single (float32)")
$real(vR, "single (float32)")
$unit(vTs, "degC", "Cel", "http://qudt.org/vocab/unit/DEG_C")
$unit(vP, "W", "W", "http://qudt.org/vocab/unit/W")
$unit(vA, "degC", "Cel", "http://qudt.org/vocab/unit/DEG_C")
$unit(vR, "degC", "Cel", "http://qudt.org/vocab/unit/DEG_C")

' ===================== Internal variables (activations) =====================
object "L1_out : GroupOfInternalVariables" as gL1o {
  name = "net.0 output"
