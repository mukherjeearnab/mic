gL1o *-- ivL1 : internalVariables
gA1o *-- ivA1 : internalVariables
gL2o *-- ivL2 : internalVariables
gA2o *-- ivA2 : internalVariables
gL3o *-- ivL3 : internalVariables
L1 ..> gL1o : outputs
A1 ..> gA1o : outputs
L2 ..> gL2o : outputs
A2 ..> gA2o : outputs
L3 ..> gL3o : outputs

$tensor2(ivL1, "batch", 0, true, "batch", "features", 32, false, "feature")
$tensor2(ivA1, "batch", 0, true, "batch", "features", 32, false, "feature")
$tensor2(ivL2, "batch", 0, true, "batch", "features", 32, false, "feature")
$tensor2(ivA2, "batch", 0, true, "batch", "features", 32, false, "feature")
$tensor2(ivL3, "batch", 0, true, "batch", "features", 1, false, "feature")
$range(ivA1, "tanh output in (-1, 1)", "-1", false, "1", false)
$range(ivA2, "tanh output in (-1, 1)", "-1", false, "1", false)
$unit(ivL3, "degC", "Cel", "http://qudt.org/vocab/unit/DEG_C")

