}
object "L3_out : GroupOfInternalVariables" as gL3o {
  name = "net.4 output"
  description = "Network output (residual)"
}
iv *-- gL1o : groups
iv *-- gA1o : groups
iv *-- gL2o : groups
iv *-- gA2o : groups
iv *-- gL3o : groups

object "z1 : InternalVariable" as ivL1 {
  name = "z1"
  description = "Linear output of net.0"
  semanticIRI = []
  quantityKind = "dimensionless"
  kind = activation
  producedBy = "net.0"
}
object "a1 : InternalVariable" as ivA1 {
  name = "a1"
